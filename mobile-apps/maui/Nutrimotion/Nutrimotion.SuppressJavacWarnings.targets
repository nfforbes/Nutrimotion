<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Suppress finalize() deprecation warning in GenericAnimatorListener.java (generated by Microsoft.Maui.Controls) -->
  <Target Name="_SuppressGenericAnimatorListenerFinalizeWarning"
      AfterTargets="_GenerateJavaStubs"
      Condition=" '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android' ">
    <ItemGroup>
      <_GenericAnimatorListenerJava Include="$(IntermediateOutputPath)android\src\**\GenericAnimatorListener.java" />
    </ItemGroup>
    <Exec Condition=" '@(_GenericAnimatorListenerJava->Count())' != '0' "
        Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\SuppressFinalizeWarning.ps1&quot; -TargetFile &quot;%(_GenericAnimatorListenerJava.FullPath)&quot;"
        IgnoreExitCode="false" />
  </Target>
</Project>
