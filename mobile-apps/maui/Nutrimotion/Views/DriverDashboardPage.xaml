<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NutrimotionApp.ViewModels"
             x:Class="NutrimotionApp.Views.DriverDashboardPage"
             Title="Driver Dashboard">

    <RefreshView Command="{Binding LoadDataCommand}"
                 IsRefreshing="{Binding IsLoading}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Summary -->
                <Frame Padding="24"
                       CornerRadius="16"
                       BackgroundColor="{StaticResource Primary}"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Center">
                        <Label Text="🚚"
                               FontSize="48"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding ActiveCount, StringFormat='{0} Active Deliveries'}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Recent Assignments -->
                <Label Text="Current Assignments"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource DarkText}" />

                <CollectionView ItemsSource="{Binding Assignments}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,0,0,8"
                                   Padding="16"
                                   CornerRadius="12"
                                   BorderColor="#E0E0E0"
                                   HasShadow="True">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding CustomerName}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource DarkText}" />
                                    <Label Text="{Binding AddressDisplay}"
                                           FontSize="13"
                                           TextColor="{StaticResource MutedText}" />
                                    <Label Text="{Binding StatusDisplay}"
                                           FontSize="14"
                                           TextColor="{StaticResource Primary}"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No active deliveries."
                               TextColor="{StaticResource MutedText}"
                               HorizontalOptions="Center"
                               Margin="0,20" />
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
