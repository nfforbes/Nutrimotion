<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:NutrimotionApp.Views"
       x:Class="NutrimotionApp.Views.ClientShell"
       Title="Nutrimotion"
       Shell.TabBarBackgroundColor="{StaticResource Primary}"
       Shell.TabBarForegroundColor="White"
       Shell.TabBarUnselectedColor="#B0B0B0">

    <TabBar>
        <ShellContent Title="Dashboard"
                      Icon="home"
                      ContentTemplate="{DataTemplate views:ClientDashboardPage}" />
    </TabBar>
</Shell>
