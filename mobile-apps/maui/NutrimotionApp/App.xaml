<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NutrimotionApp"
             x:Class="NutrimotionApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#512BD4</Color>
            <Color x:Key="PrimaryDark">#3B1F9E</Color>
            <Color x:Key="Accent">#FF6B35</Color>
            <Color x:Key="LightBackground">#F5F5F5</Color>
            <Color x:Key="DarkText">#1A1A1A</Color>
            <Color x:Key="MutedText">#757575</Color>

            <local:IsNotNullConverter x:Key="IsNotNullConverter" />
            <local:StatusToPreparingConverter x:Key="StatusToPreparingConverter" />
            <local:StatusToOutForDeliveryConverter x:Key="StatusToOutForDeliveryConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
