# Auth0 v4 Configuration
# Generate AUTH0_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH0_SECRET='<generate-with-command-above>'
APP_BASE_URL='https://localhost:3000'
AUTH0_DOMAIN='YOUR_DOMAIN.us.auth0.com'
AUTH0_CLIENT_ID='YOUR_CLIENT_ID'
AUTH0_CLIENT_SECRET='YOUR_CLIENT_SECRET'

# (Optional) Auth0 API audience for mobile JWT verification.
# If set, Bearer tokens from the MAUI app are validated against this audience.
# If not set, AUTH0_CLIENT_ID is used as the audience.
# AUTH0_AUDIENCE='https://YOUR_DOMAIN.us.auth0.com/api/v2/'

# MongoDB Configuration
MONGODB_URI='mongodb://localhost:27017/nutrimotion'

# Application Configuration
NEXT_PUBLIC_APP_URL='https://localhost:3000'

# Media Security
MEDIA_SECRET='<generate-long-random-string>'
