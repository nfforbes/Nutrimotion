{
  "name": "nutrimotion-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cert:generate": "node scripts/generate-cert.js",
    "cert:force": "node scripts/generate-cert.js --force",
    "make-admin": "node scripts/make-admin.js",
    "seed:meals": "node scripts/seed-weekly-meals.js --clear",
    "manage-roles": "node scripts/manage-roles.js",
    "dev": "npm-run-all --parallel dev:next dev:proxy",
    "dev:next": "cross-env NODE_OPTIONS=--max-http-header-size=81920 next dev -p 3001 --webpack",
    "dev:proxy": "local-ssl-proxy --source 3000 --target 3001 --cert cert/localhost.pem --key cert/localhost-key.pem",
    "dev:http": "cross-env NODE_OPTIONS=--max-http-header-size=81920 next dev -p 3000",
    "dev:custom": "cross-env NODE_OPTIONS=--max-http-header-size=81920 node server.js",
    "build": "cross-env NODE_OPTIONS=--max-http-header-size=81920 next build",
    "start": "cross-env NODE_ENV=production NODE_OPTIONS=--max-http-header-size=81920 node server.js",
    "start:http": "cross-env NODE_OPTIONS=--max-http-header-size=81920 next start -p 3000",
    "lint": "next lint",
    "test": "jest  --watch",
    "test:ci": "jest --ci",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.15.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@reduxjs/toolkit": "^2.2.0",
    "axios": "^1.6.0",
    "date-fns": "^3.3.0",
    "googleapis": "^171.4.0",
    "leaflet": "^1.9.4",
    "mongoose": "^9.2.1",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.1.0",
    "redux-saga": "^1.3.0",
    "zod": "^3.22.0"
  },
  "overrides": {},
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^29.5.0",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.0.1",
    "cross-env": "^10.1.0",
    "devcert": "^1.2.2",
    "eslint": "^8",
    "eslint-config-next": "^16.1.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "local-ssl-proxy": "^2.0.5",
    "npm-run-all": "^4.1.5",
    "postcss": "^8",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5"
  }
}
